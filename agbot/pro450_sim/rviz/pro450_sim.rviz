Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: moveit_task_constructor/Motion Planning Tasks
    Name: Motion Planning Tasks
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: world
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Links:
        All Links Enabled: true
      Name: Pro450 Robot
      TF Prefix: ""
      Visual Enabled: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: PottedPlant
      Namespaces:
        simple_potted_plant: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plant_marker
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Plant Collision Proxies
      Namespaces:
        plant_collision_proxies: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plant_collision_markers
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Ranked Landing Points
      Namespaces:
        projected_grasp_labels: true
        ranked_grasp_points: true
      Topic:
        Depth: 10
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /leaf_perception/projected_grasp_candidates
    - Class: rviz_default_plugins/PointCloud2
      Color Transformer: RGB8
      # The Pro450 launch converts the Fortress cloud into the D435 optical
      # convention, so it can be compared directly with the RGB/depth images.
      Enabled: true
      Name: D435 Point Cloud
      Queue Size: 10
      Size (Pixels): 3
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/depth/color/points
    - Class: rviz_default_plugins/PointCloud2
      Color: 255; 180; 40
      Color Transformer: FlatColor
      Enabled: true
      Name: Fused Canopy
      Queue Size: 2
      Size (Pixels): 4
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /leaf_perception/fused_canopy
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: RGB Image
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/color/image_raw
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Depth Image
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/depth/image_raw
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
    - Class: moveit_task_constructor/Motion Planning Tasks
      Enabled: true
      Interrupt Display: false
      Loop Animation: false
      Markers:
        All at once?: false
        Value: true
      Name: Motion Planning Tasks
      Robot:
        Robot Alpha: 0.5
        Show Robot Collision: false
        Show Robot Visual: true
        Use Fixed Robot Color: false
      Robot Description: robot_description
      Scene:
        Scene Alpha: 0.9
        Value: true
      Show Trail: false
      State Display Time: 0.05 s
      Task Solution Topic: /solution
      Trail Step Size: 1
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.6
      Focal Point:
        X: 0.2
        Y: 0.0
        Z: 0.3
      Name: Current View
      Pitch: 0.35
      Target Frame: <Fixed Frame>
      Yaw: 0.8
