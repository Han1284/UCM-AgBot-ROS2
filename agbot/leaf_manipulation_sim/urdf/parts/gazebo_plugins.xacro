<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="rg2_mimic_plugins" params="prefix:=''">
    <gazebo>
      <plugin filename="libroboticsgroup_upatras_gazebo_mimic_joint_plugin.so" name="mimic_${prefix}left_inner_knuckle_joint">
        <joint>${prefix}finger_joint</joint>
        <mimicJoint>${prefix}left_inner_knuckle_joint</mimicJoint>
        <multiplier>-1.0</multiplier>
        <offset>0.0</offset>
        <maxEffort>5.0</maxEffort>
      </plugin>
      <plugin filename="libroboticsgroup_upatras_gazebo_mimic_joint_plugin.so" name="mimic_${prefix}right_inner_knuckle_joint">
        <joint>${prefix}finger_joint</joint>
        <mimicJoint>${prefix}right_inner_knuckle_joint</mimicJoint>
        <multiplier>-1.0</multiplier>
        <offset>0.0</offset>
        <maxEffort>5.0</maxEffort>
      </plugin>
      <plugin filename="libroboticsgroup_upatras_gazebo_mimic_joint_plugin.so" name="mimic_${prefix}left_inner_finger_joint">
        <joint>${prefix}finger_joint</joint>
        <mimicJoint>${prefix}left_inner_finger_joint</mimicJoint>
        <multiplier>1.0</multiplier>
        <offset>0.0</offset>
        <maxEffort>5.0</maxEffort>
      </plugin>
      <plugin filename="libroboticsgroup_upatras_gazebo_mimic_joint_plugin.so" name="mimic_${prefix}right_inner_finger_joint">
        <joint>${prefix}finger_joint</joint>
        <mimicJoint>${prefix}right_inner_finger_joint</mimicJoint>
        <multiplier>1.0</multiplier>
        <offset>0.0</offset>
        <maxEffort>5.0</maxEffort>
      </plugin>
      <plugin filename="libroboticsgroup_upatras_gazebo_mimic_joint_plugin.so" name="mimic_${prefix}right_outer_knuckle_joint">
        <joint>${prefix}finger_joint</joint>
        <mimicJoint>${prefix}right_outer_knuckle_joint</mimicJoint>
        <multiplier>-1.0</multiplier>
        <offset>0.0</offset>
        <maxEffort>5.0</maxEffort>
      </plugin>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="gazebo_ros2_control_plugin">
    <gazebo>
      <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
        <parameters>$(find leaf_manipulation_sim)/config/arm_controllers.yaml</parameters>
      </plugin>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="d435_depth_camera" params="parent_link:='camera_link' frame_name:='camera_depth_optical_frame' namespace:='/camera'">
    <gazebo reference="${parent_link}">
      <sensor name="d435_depth_camera" type="depth">
        <always_on>true</always_on>
        <update_rate>10.0</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>3.0</far>
          </clip>
        </camera>
        <plugin name="d435_plugin" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>${namespace}</namespace>
            <remapping>d435_depth_camera/image_raw:=color/image_raw</remapping>
            <remapping>d435_depth_camera/camera_info:=color/camera_info</remapping>
            <remapping>d435_depth_camera/depth/image_raw:=depth/image_raw</remapping>
            <remapping>d435_depth_camera/depth/camera_info:=depth/camera_info</remapping>
            <remapping>d435_depth_camera/points:=depth/color/points</remapping>
          </ros>
          <frame_name>${frame_name}</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>
