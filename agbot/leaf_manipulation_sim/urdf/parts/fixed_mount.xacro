<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="fixed_pedestal" params="height:=0.75 width:=0.45 depth:=0.45">
    <link name="pedestal_link">
      <visual>
        <geometry>
          <box size="${width} ${depth} ${height}"/>
        </geometry>
        <material name="pedestal_gray">
          <color rgba="0.55 0.55 0.55 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="${width} ${depth} ${height}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="30.0"/>
        <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
      </inertial>
    </link>

    <joint name="world_to_pedestal" type="fixed">
      <parent link="world"/>
      <child link="pedestal_link"/>
      <origin xyz="0 0 ${height / 2.0}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="pedestal_link">
      <material>Gazebo/Grey</material>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="bench_camera" params="parent_link:='pedestal_link'">
    <link name="camera_link">
      <visual>
        <geometry>
          <box size="0.05 0.12 0.04"/>
        </geometry>
        <material name="camera_black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.05 0.12 0.04"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>

    <joint name="pedestal_to_camera" type="fixed">
      <parent link="${parent_link}"/>
      <child link="camera_link"/>
      <origin xyz="0.30 0.0 0.45" rpy="0 0.35 0"/>
    </joint>
  </xacro:macro>

</robot>
