<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="gz_ros2_control_plugin">
    <gazebo>
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <robot_param>robot_description</robot_param>
        <robot_param_node>robot_state_publisher</robot_param_node>
        <parameters>$(find leaf_manipulation_sim)/config/arm_controllers.yaml</parameters>
      </plugin>
    </gazebo>
  </xacro:macro>

  <!-- Fortress publishes native Gazebo Transport RGB-D streams.  The launch
       bridge remaps these streams back to the ROS names used before migration. -->
  <xacro:macro name="d435_gz_rgbd_camera" params="parent_link:='camera_bottom_screw_frame'">
    <gazebo reference="${parent_link}">
      <sensor name="d435_depth_camera" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>10.0</update_rate>
        <visualize>false</visualize>
        <topic>/camera_gz</topic>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>3.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>
