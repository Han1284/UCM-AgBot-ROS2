<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="fixed_stand" params="height:=0.75 width:=0.40 depth:=0.40 plate_height:=0.04">
    <link name="base_root"/>

    <link name="stand_link">
      <visual name="stand_visual">
        <origin xyz="0 0 ${height / 2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${width} ${depth} ${height}"/>
        </geometry>
        <material name="stand_gray">
          <color rgba="0.70 0.70 0.75 1.0"/>
        </material>
      </visual>
      <collision name="stand_collision">
        <origin xyz="0 0 ${height / 2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${width} ${depth} ${height}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${height / 2.0}" rpy="0 0 0"/>
        <mass value="25.0"/>
        <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
      </inertial>
    </link>

    <link name="mount_plate_link">
      <visual name="plate_visual">
        <origin xyz="0 0 ${plate_height / 2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${width} ${depth} ${plate_height}"/>
        </geometry>
        <material name="plate_dark">
          <color rgba="0.35 0.35 0.38 1.0"/>
        </material>
      </visual>
      <collision name="plate_collision">
        <origin xyz="0 0 ${plate_height / 2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${width} ${depth} ${plate_height}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${plate_height / 2.0}" rpy="0 0 0"/>
        <mass value="2.0"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
      </inertial>
    </link>

    <joint name="root_to_stand" type="fixed">
      <parent link="base_root"/>
      <child link="stand_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <joint name="stand_to_plate" type="fixed">
      <parent link="stand_link"/>
      <child link="mount_plate_link"/>
      <origin xyz="0 0 ${height}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="stand_link">
      <material>Gazebo/Grey</material>
      <static>true</static>
    </gazebo>
    <gazebo reference="mount_plate_link">
      <material>Gazebo/DarkGrey</material>
      <static>true</static>
    </gazebo>
  </xacro:macro>

</robot>
