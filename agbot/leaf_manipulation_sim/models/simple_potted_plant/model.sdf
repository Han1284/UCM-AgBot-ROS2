    <link name="original_leaf_4"><pose>-0.072 -0.118 0.472 0 0 0</pose><inertial><mass>0.0025</mass><inertia><ixx>0.000004</ixx><iyy>0.000004</iyy><izz>0.000002</izz></inertia></inertial><visual name="visual"><geometry><mesh><uri>model://simple_potted_plant/meshes/original_leaf_pilot/original_leaf_segment_4.obj</uri></mesh></geometry></visual><collision name="collision"><pose>-0.0265 -0.0450 0.0280 0 -0.488 -2.103</pose><geometry><box><size>0.110 0.060 0.006</size></box></geometry></collision></link>
    <link name="original_leaf_5"><pose>-0.125 -0.208 0.528 0 0 0</pose><inertial><mass>0.0020</mass><inertia><ixx>0.000003</ixx><iyy>0.000003</iyy><izz>0.0000015</izz></inertia></inertial><visual name="visual"><geometry><mesh><uri>model://simple_potted_plant/meshes/original_leaf_pilot/original_leaf_segment_5.obj</uri></mesh></geometry></visual><collision name="collision"><pose>-0.0160 -0.0330 0.0010 0 -0.027 -2.022</pose><geometry><box><size>0.074 0.035 0.006</size></box></geometry></collision></link>
    <joint name="original_leaf_j1" type="universal"><pose>0.010 0.005 0.200 0 0 0</pose><parent>stem_1</parent><child>original_leaf_1</child><axis><xyz>1 0 0</xyz><limit><lower>-0.45</lower><upper>0.45</upper><effort>0.8</effort><velocity>2</velocity></limit><dynamics><damping>0.045</damping><spring_reference>0</spring_reference><spring_stiffness>0.50</spring_stiffness></dynamics></axis><axis2><xyz>0 1 0</xyz><limit><lower>-0.45</lower><upper>0.45</upper><effort>0.8</effort><velocity>2</velocity></limit><dynamics><damping>0.045</damping><spring_reference>0</spring_reference><spring_stiffness>0.50</spring_stiffness></dynamics></axis2></joint>
