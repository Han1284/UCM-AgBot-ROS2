<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="simple_potted_plant">
    <!-- The grasp test does not need plant deformation. Keeping the plant
         static avoids numerical drift and makes contact measurements repeatable. -->
    <static>true</static>
    <self_collide>false</self_collide>

    <link name="plant_link">
      <gravity>false</gravity>

      <!-- The downloaded DAE is still used by RViz. Gazebo Fortress 6 crashes
           in its Collada polylist loader on that file, so this is a lossless
           triangulated OBJ export of the same three meshes and materials. -->
      <visual name="plant_visual">
        <!-- Assimp exports Z_UP Collada as Y_UP OBJ; this restores Z_UP. -->
        <pose>0 0 0.0001 1.57079632679 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://simple_potted_plant/meshes/FlowerPot_fortress.obj</uri>
            <scale>0.10 0.10 0.10</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name="pot_collision">
        <!-- The pot mesh spans z=0.00001..0.23186 m after its visual
             transform. Match those vertical bounds instead of ending 7.2 cm
             below the visible rim. -->
        <pose>0 0 0.116 0 0 0</pose>
        <geometry><cylinder><radius>0.12</radius><length>0.232</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          <contact><ode><kp>1000000</kp><kd>10</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact>
        </surface>
      </collision>

      <!-- Invisible grasp proxies fitted to the broad region of each original
           leaf. They are deliberately primitive rather than triangle meshes:
           gripper contact is faster and more stable with thin boxes. -->
      <collision name="leaf_1_segment_4_collision">
        <pose>-0.0985 -0.1630 0.5000 0 -0.4922 -2.1030</pose>
        <geometry><box><size>0.1265 0.0650 0.0080</size></box></geometry>
        <max_contacts>20</max_contacts>
        <surface>
          <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          <contact><ode><kp>200000</kp><kd>20</kd><max_vel>0.005</max_vel><min_depth>0.0005</min_depth></ode></contact>
        </surface>
      </collision>
      <collision name="leaf_2_segment_4_collision">
        <pose>0.1775 -0.1400 0.5025 0 -0.4632 -0.6889</pose>
        <geometry><box><size>0.1311 0.0650 0.0080</size></box></geometry>
        <max_contacts>20</max_contacts>
        <surface>
          <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          <contact><ode><kp>200000</kp><kd>20</kd><max_vel>0.005</max_vel><min_depth>0.0005</min_depth></ode></contact>
        </surface>
      </collision>
      <collision name="leaf_3_segment_4_collision">
        <pose>0.1080 0.1100 0.3825 0 -0.3591 0.8491</pose>
        <geometry><box><size>0.0791 0.0550 0.0080</size></box></geometry>
        <max_contacts>20</max_contacts>
        <surface>
          <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          <contact><ode><kp>200000</kp><kd>20</kd><max_vel>0.005</max_vel><min_depth>0.0005</min_depth></ode></contact>
        </surface>
      </collision>
      <collision name="leaf_4_segment_4_collision">
        <pose>-0.1035 0.1450 0.4365 0 -0.4283 2.3036</pose>
        <geometry><box><size>0.1115 0.0600 0.0080</size></box></geometry>
        <max_contacts>20</max_contacts>
        <surface>
          <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          <contact><ode><kp>200000</kp><kd>20</kd><max_vel>0.005</max_vel><min_depth>0.0005</min_depth></ode></contact>
        </surface>
      </collision>

      <!-- Additional short proxies follow the remaining mesh spans from leaf
           root to tip. Together with segment 4 above this gives five boxes
           per leaf and avoids one long box cutting across the curved surface. -->
      <collision name="leaf_1_segment_1_collision">
        <pose>0.0025 -0.0025 0.2425 0 -1.3262 -2.3562</pose>
        <geometry><box><size>0.0956 0.0200 0.0080</size></box></geometry>
        <max_contacts>20</max_contacts>
        <surface>
          <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          <contact><ode><kp>200000</kp><kd>20</kd><max_vel>0.005</max_vel><min_depth>0.0005</min_depth></ode></contact>
        </surface>
      </collision>
      <collision name="leaf_1_segment_2_collision">
        <pose>-0.0165 -0.0300 0.3350 0 -1.1385 -2.0926</pose>
        <geometry><box><size>0.1181 0.0350 0.0080</size></box></geometry>
        <max_contacts>20</max_contacts>
        <surface>
          <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          <contact><ode><kp>200000</kp><kd>20</kd><max_vel>0.005</max_vel><min_depth>0.0005</min_depth></ode></contact>
        </surface>
      </collision>
      <collision name="leaf_1_segment_3_collision">
        <pose>-0.0500 -0.0840 0.4285 0 -0.8211 -2.1451</pose>
        <geometry><box><size>0.1269 0.0500 0.0080</size></box></geometry>
        <max_contacts>20</max_contacts>
        <surface>
          <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          <contact><ode><kp>200000</kp><kd>20</kd><max_vel>0.005</max_vel><min_depth>0.0005</min_depth></ode></contact>
        </surface>
      </collision>
      <collision name="leaf_1_segment_5_collision">
        <pose>-0.1410 -0.2410 0.5290 0 -0.0273 -2.0222</pose>
        <geometry><box><size>0.0814 0.0450 0.0080</size></box></geometry>
        <max_contacts>20</max_contacts>
        <surface>
          <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          <contact><ode><kp>200000</kp><kd>20</kd><max_vel>0.005</max_vel><min_depth>0.0005</min_depth></ode></contact>
        </surface>
      </collision>
      <collision name="leaf_2_segment_1_collision">
        <pose>0.0305 -0.0025 0.2405 0 -1.3767 -1.0304</pose>
        <geometry><box><size>0.0987 0.0200 0.0080</size></box></geometry>
        <max_contacts>20</max_contacts>
        <surface>
          <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          <contact><ode><kp>200000</kp><kd>20</kd><max_vel>0.005</max_vel><min_depth>0.0005</min_depth></ode></contact>
        </surface>
      </collision>
      <collision name="leaf_2_segment_2_collision">
        <pose>0.0550 -0.0325 0.3375 0 -1.0502 -0.8442</pose>
        <geometry><box><size>0.1290 0.0350 0.0080</size></box></geometry>
        <max_contacts>20</max_contacts>
        <surface>
          <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          <contact><ode><kp>200000</kp><kd>20</kd><max_vel>0.005</max_vel><min_depth>0.0005</min_depth></ode></contact>
        </surface>
      </collision>
      <collision name="leaf_2_segment_3_collision">
        <pose>0.1050 -0.0800 0.4325 0 -0.8277 -0.6947</pose>
        <geometry><box><size>0.1234 0.0500 0.0080</size></box></geometry>
        <max_contacts>20</max_contacts>
        <surface>
          <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          <contact><ode><kp>200000</kp><kd>20</kd><max_vel>0.005</max_vel><min_depth>0.0005</min_depth></ode></contact>
        </surface>
      </collision>
      <collision name="leaf_2_segment_5_collision">
        <pose>0.2455 -0.1930 0.5275 0 0.0799 -0.6147</pose>
        <geometry><box><size>0.0706 0.0450 0.0080</size></box></geometry>
        <max_contacts>20</max_contacts>
        <surface>
          <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          <contact><ode><kp>200000</kp><kd>20</kd><max_vel>0.005</max_vel><min_depth>0.0005</min_depth></ode></contact>
        </surface>
      </collision>
      <collision name="leaf_3_segment_1_collision">
        <pose>0.0225 0.0190 0.2235 0 -1.3745 0.4993</pose>
        <geometry><box><size>0.0722 0.0180 0.0080</size></box></geometry>
        <max_contacts>20</max_contacts>
        <surface>
          <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          <contact><ode><kp>200000</kp><kd>20</kd><max_vel>0.005</max_vel><min_depth>0.0005</min_depth></ode></contact>
        </surface>
      </collision>
      <collision name="leaf_3_segment_2_collision">
        <pose>0.0415 0.0360 0.2875 0 -1.0315 0.8036</pose>
        <geometry><box><size>0.0837 0.0300 0.0080</size></box></geometry>
        <max_contacts>20</max_contacts>
        <surface>
          <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
