<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="simple_potted_plant">
    <!-- The grasp test does not need plant deformation. Keeping the plant
         static avoids numerical drift and makes contact measurements repeatable. -->
    <static>true</static>
    <self_collide>false</self_collide>

    <link name="plant_link">
      <gravity>false</gravity>

      <!-- Preserve the downloaded asset exactly as the user-visible model. -->
      <visual name="pot_visual">
        <pose>0 0 0.0001 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://simple_potted_plant/meshes/FlowerPot.dae</uri>
            <scale>0.10 0.10 0.10</scale>
            <submesh><name>FlowerPot</name><center>false</center></submesh>
          </mesh>
        </geometry>
      </visual>
      <visual name="soil_visual">
        <pose>0 0 0.0001 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://simple_potted_plant/meshes/FlowerPot.dae</uri>
            <scale>0.10 0.10 0.10</scale>
            <submesh><name>Soil</name><center>false</center></submesh>
          </mesh>
        </geometry>
      </visual>
      <visual name="foliage_visual">
        <pose>0 0 0.0001 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://simple_potted_plant/meshes/FlowerPot.dae</uri>
            <scale>0.10 0.10 0.10</scale>
            <submesh><name>Foliage</name><center>false</center></submesh>
          </mesh>
        </geometry>
      </visual>

      <collision name="pot_collision">
        <pose>0 0 0.08 0 0 0</pose>
        <geometry><cylinder><radius>0.12</radius><length>0.16</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          <contact><ode><kp>1000000</kp><kd>10</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact>
        </surface>
      </collision>

      <!-- Invisible grasp proxies fitted to the broad region of each original
           leaf. They are deliberately primitive rather than triangle meshes:
           gripper contact is faster and more stable with thin boxes. -->
      <collision name="leaf_1_grasp_collision">
        <pose>-0.1145 -0.1960 0.5010 0 -0.3156 -2.0697</pose>
        <geometry><box><size>0.1969 0.0650 0.0080</size></box></geometry>
        <max_contacts>20</max_contacts>
        <surface>
          <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          <contact><ode><kp>200000</kp><kd>20</kd><max_vel>0.005</max_vel><min_depth>0.0005</min_depth></ode></contact>
        </surface>
      </collision>
      <collision name="leaf_2_grasp_collision">
        <pose>0.2030 -0.1580 0.5000 0 -0.2822 -0.6621</pose>
        <geometry><box><size>0.1895 0.0650 0.0080</size></box></geometry>
        <max_contacts>20</max_contacts>
        <surface>
          <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          <contact><ode><kp>200000</kp><kd>20</kd><max_vel>0.005</max_vel><min_depth>0.0005</min_depth></ode></contact>
        </surface>
      </collision>
      <collision name="leaf_3_grasp_collision">
        <pose>0.1175 0.1250 0.3815 0 -0.2221 0.9037</pose>
        <geometry><box><size>0.1144 0.0550 0.0080</size></box></geometry>
        <max_contacts>20</max_contacts>
        <surface>
          <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          <contact><ode><kp>200000</kp><kd>20</kd><max_vel>0.005</max_vel><min_depth>0.0005</min_depth></ode></contact>
        </surface>
      </collision>
      <collision name="leaf_4_grasp_collision">
        <pose>-0.1220 0.1625 0.4335 0 -0.2498 2.3318</pose>
        <geometry><box><size>0.1596 0.0600 0.0080</size></box></geometry>
        <max_contacts>20</max_contacts>
        <surface>
          <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          <contact><ode><kp>200000</kp><kd>20</kd><max_vel>0.005</max_vel><min_depth>0.0005</min_depth></ode></contact>
        </surface>
      </collision>

      <sensor name="leaf_1_contact_sensor" type="contact">
        <always_on>true</always_on><update_rate>100</update_rate>
        <contact><collision>leaf_1_grasp_collision</collision></contact>
        <plugin name="leaf_1_contact_ros" filename="libgazebo_ros_bumper.so">
          <ros><namespace>/plant</namespace><remapping>bumper_states:=leaf_1_contacts</remapping></ros>
          <frame_name>world</frame_name>
        </plugin>
      </sensor>
      <sensor name="leaf_2_contact_sensor" type="contact">
        <always_on>true</always_on><update_rate>100</update_rate>
        <contact><collision>leaf_2_grasp_collision</collision></contact>
        <plugin name="leaf_2_contact_ros" filename="libgazebo_ros_bumper.so">
          <ros><namespace>/plant</namespace><remapping>bumper_states:=leaf_2_contacts</remapping></ros>
          <frame_name>world</frame_name>
        </plugin>
      </sensor>
      <sensor name="leaf_3_contact_sensor" type="contact">
        <always_on>true</always_on><update_rate>100</update_rate>
        <contact><collision>leaf_3_grasp_collision</collision></contact>
        <plugin name="leaf_3_contact_ros" filename="libgazebo_ros_bumper.so">
          <ros><namespace>/plant</namespace><remapping>bumper_states:=leaf_3_contacts</remapping></ros>
          <frame_name>world</frame_name>
        </plugin>
      </sensor>
      <sensor name="leaf_4_contact_sensor" type="contact">
        <always_on>true</always_on><update_rate>100</update_rate>
        <contact><collision>leaf_4_grasp_collision</collision></contact>
        <plugin name="leaf_4_contact_ros" filename="libgazebo_ros_bumper.so">
          <ros><namespace>/plant</namespace><remapping>bumper_states:=leaf_4_contacts</remapping></ros>
          <frame_name>world</frame_name>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
