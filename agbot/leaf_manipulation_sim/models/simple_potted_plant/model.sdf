        <geometry><box><size>0.1106 0.0320 0.0080</size></box></geometry>
        <max_contacts>20</max_contacts>
        <surface>
          <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          <contact><ode><kp>200000</kp><kd>20</kd><max_vel>0.005</max_vel><min_depth>0.0005</min_depth></ode></contact>
        </surface>
      </collision>
      <collision name="leaf_4_segment_3_collision">
        <pose>-0.0510 0.0875 0.3800 0 -0.8495 2.3217</pose>
        <geometry><box><size>0.1012 0.0480 0.0080</size></box></geometry>
        <max_contacts>20</max_contacts>
        <surface>
          <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          <contact><ode><kp>200000</kp><kd>20</kd><max_vel>0.005</max_vel><min_depth>0.0005</min_depth></ode></contact>
        </surface>
      </collision>
      <collision name="leaf_4_segment_5_collision">
        <pose>-0.1535 0.1975 0.4550 0 0.1173 2.3840</pose>
        <geometry><box><size>0.0593 0.0400 0.0080</size></box></geometry>
        <max_contacts>20</max_contacts>
        <surface>
          <friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction>
          <contact><ode><kp>200000</kp><kd>20</kd><max_vel>0.005</max_vel><min_depth>0.0005</min_depth></ode></contact>
        </surface>
      </collision>

      <sensor name="leaf_1_segment_4_contact_sensor" type="contact">
        <always_on>true</always_on><update_rate>100</update_rate>
        <contact><collision>leaf_1_segment_4_collision</collision><topic>/plant/leaf_1_contacts_gz</topic></contact>
      </sensor>
      <sensor name="leaf_2_segment_4_contact_sensor" type="contact">
        <always_on>true</always_on><update_rate>100</update_rate>
        <contact><collision>leaf_2_segment_4_collision</collision><topic>/plant/leaf_2_contacts_gz</topic></contact>
      </sensor>
      <sensor name="leaf_3_segment_4_contact_sensor" type="contact">
        <always_on>true</always_on><update_rate>100</update_rate>
        <contact><collision>leaf_3_segment_4_collision</collision><topic>/plant/leaf_3_contacts_gz</topic></contact>
      </sensor>
      <sensor name="leaf_4_segment_4_contact_sensor" type="contact">
        <always_on>true</always_on><update_rate>100</update_rate>
        <contact><collision>leaf_4_segment_4_collision</collision><topic>/plant/leaf_4_contacts_gz</topic></contact>
      </sensor>
      <!-- Every proxy has a contact sensor. The five publishers for one leaf
           intentionally share one ROS topic so callers only monitor four topics. -->
      <sensor name="leaf_1_segment_1_contact_sensor" type="contact">
        <always_on>true</always_on><update_rate>100</update_rate>
        <contact><collision>leaf_1_segment_1_collision</collision><topic>/plant/leaf_1_contacts_gz</topic></contact>
      </sensor>
      <sensor name="leaf_1_segment_2_contact_sensor" type="contact">
        <always_on>true</always_on><update_rate>100</update_rate>
