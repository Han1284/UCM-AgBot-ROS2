<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="simple_potted_plant">
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <!-- Fixed rigid pot. Only the pot and soil submeshes are retained from the
         downloaded asset; the foliage below is articulated so it can deform. -->
    <link name="pot_link">
      <pose>0 0 0 0 0 0</pose>
      <gravity>false</gravity>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz>
        </inertia>
      </inertial>
      <visual name="pot_visual">
        <pose>0 0 0.0001 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://simple_potted_plant/meshes/FlowerPot.dae</uri>
            <scale>0.10 0.10 0.10</scale>
            <submesh><name>FlowerPot</name><center>false</center></submesh>
          </mesh>
        </geometry>
      </visual>
      <visual name="soil_visual">
        <pose>0 0 0.0001 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://simple_potted_plant/meshes/FlowerPot.dae</uri>
            <scale>0.10 0.10 0.10</scale>
            <submesh><name>Soil</name><center>false</center></submesh>
          </mesh>
        </geometry>
      </visual>
      <collision name="pot_collision">
        <pose>0 0 0.08 0 0 0</pose>
        <geometry><cylinder><radius>0.12</radius><length>0.16</length></cylinder></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
    </link>
    <joint name="pot_world_anchor" type="fixed">
      <parent>world</parent><child>pot_link</child>
    </joint>

    <!-- Three capsule-like stem sections. Universal spring joints provide
         bending in two directions while keeping the root anchored in the pot. -->
    <link name="stem_1">
      <pose>0 0 0.21 0 0 0</pose>
      <inertial><mass>0.02</mass><inertia><ixx>0.0000174</ixx><iyy>0.0000174</iyy><izz>0.00000144</izz></inertia></inertial>
      <visual name="visual"><geometry><cylinder><radius>0.012</radius><length>0.10</length></cylinder></geometry><material><ambient>0.12 0.42 0.08 1</ambient><diffuse>0.18 0.55 0.10 1</diffuse></material></visual>
      <collision name="collision"><geometry><cylinder><radius>0.012</radius><length>0.10</length></cylinder></geometry></collision>
      <velocity_decay><linear>0.02</linear><angular>0.04</angular></velocity_decay>
    </link>
    <link name="stem_2">
      <pose>0 0 0.31 0 0 0</pose>
      <inertial><mass>0.018</mass><inertia><ixx>0.0000157</ixx><iyy>0.0000157</iyy><izz>0.00000130</izz></inertia></inertial>
      <visual name="visual"><geometry><cylinder><radius>0.012</radius><length>0.10</length></cylinder></geometry><material><ambient>0.12 0.42 0.08 1</ambient><diffuse>0.18 0.55 0.10 1</diffuse></material></visual>
      <collision name="collision"><geometry><cylinder><radius>0.012</radius><length>0.10</length></cylinder></geometry></collision>
      <velocity_decay><linear>0.02</linear><angular>0.04</angular></velocity_decay>
    </link>
    <link name="stem_3">
      <pose>0 0 0.41 0 0 0</pose>
      <inertial><mass>0.015</mass><inertia><ixx>0.0000131</ixx><iyy>0.0000131</iyy><izz>0.00000108</izz></inertia></inertial>
      <visual name="visual"><geometry><cylinder><radius>0.012</radius><length>0.10</length></cylinder></geometry><material><ambient>0.12 0.42 0.08 1</ambient><diffuse>0.18 0.55 0.10 1</diffuse></material></visual>
      <collision name="collision"><geometry><cylinder><radius>0.012</radius><length>0.10</length></cylinder></geometry></collision>
      <velocity_decay><linear>0.02</linear><angular>0.04</angular></velocity_decay>
    </link>

    <joint name="stem_root_joint" type="universal">
      <pose>0 0 0.16 0 0 0</pose><parent>pot_link</parent><child>stem_1</child>
      <axis><xyz>1 0 0</xyz><limit><lower>-0.40</lower><upper>0.40</upper><effort>4</effort><velocity>2</velocity></limit><dynamics><damping>0.08</damping><spring_reference>0</spring_reference><spring_stiffness>2.4</spring_stiffness></dynamics></axis>
      <axis2><xyz>0 1 0</xyz><limit><lower>-0.40</lower><upper>0.40</upper><effort>4</effort><velocity>2</velocity></limit><dynamics><damping>0.08</damping><spring_reference>0</spring_reference><spring_stiffness>2.4</spring_stiffness></dynamics></axis2>
    </joint>
    <joint name="stem_joint_2" type="universal">
      <pose>0 0 0.26 0 0 0</pose><parent>stem_1</parent><child>stem_2</child>
      <axis><xyz>1 0 0</xyz><limit><lower>-0.45</lower><upper>0.45</upper><effort>3</effort><velocity>2</velocity></limit><dynamics><damping>0.06</damping><spring_reference>0</spring_reference><spring_stiffness>1.8</spring_stiffness></dynamics></axis>
      <axis2><xyz>0 1 0</xyz><limit><lower>-0.45</lower><upper>0.45</upper><effort>3</effort><velocity>2</velocity></limit><dynamics><damping>0.06</damping><spring_reference>0</spring_reference><spring_stiffness>1.8</spring_stiffness></dynamics></axis2>
    </joint>
    <joint name="stem_joint_3" type="universal">
      <pose>0 0 0.36 0 0 0</pose><parent>stem_2</parent><child>stem_3</child>
      <axis><xyz>1 0 0</xyz><limit><lower>-0.55</lower><upper>0.55</upper><effort>2</effort><velocity>2</velocity></limit><dynamics><damping>0.05</damping><spring_reference>0</spring_reference><spring_stiffness>1.2</spring_stiffness></dynamics></axis>
      <axis2><xyz>0 1 0</xyz><limit><lower>-0.55</lower><upper>0.55</upper><effort>2</effort><velocity>2</velocity></limit><dynamics><damping>0.05</damping><spring_reference>0</spring_reference><spring_stiffness>1.2</spring_stiffness></dynamics></axis2>
    </joint>

    <!-- Four leaves, each discretized into four overlapping mesh sections.
         Collision stays primitive while visual curvature follows the joints. -->
    <link name="leaf_e_1"><pose>0.045 0 0.29 0 0 0</pose><inertial><mass>0.0035</mass><inertia><ixx>0.0000005</ixx><iyy>0.0000015</iyy><izz>0.0000018</izz></inertia></inertial><visual name="visual"><geometry><mesh><uri>model://simple_potted_plant/meshes/leaf_segment.obj</uri><scale>1 0.95 1</scale></mesh></geometry><material><ambient>0.04 0.34 0.06 1</ambient><diffuse>0.07 0.68 0.11 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.062 0.040 0.004</size></box></geometry></collision></link>
    <link name="leaf_e_2"><pose>0.105 0 0.29 0 0 0</pose><inertial><mass>0.0030</mass><inertia><ixx>0.00000045</ixx><iyy>0.0000013</iyy><izz>0.0000016</izz></inertia></inertial><visual name="visual"><geometry><mesh><uri>model://simple_potted_plant/meshes/leaf_segment.obj</uri><scale>1 0.90 1</scale></mesh></geometry><material><ambient>0.04 0.34 0.06 1</ambient><diffuse>0.07 0.68 0.11 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.062 0.038 0.004</size></box></geometry></collision></link>
    <link name="leaf_e_3"><pose>0.165 0 0.29 0 0 0</pose><inertial><mass>0.0025</mass><inertia><ixx>0.0000004</ixx><iyy>0.0000011</iyy><izz>0.0000014</izz></inertia></inertial><visual name="visual"><geometry><mesh><uri>model://simple_potted_plant/meshes/leaf_segment.obj</uri><scale>1 0.80 1</scale></mesh></geometry><material><ambient>0.04 0.34 0.06 1</ambient><diffuse>0.07 0.68 0.11 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.062 0.034 0.004</size></box></geometry></collision></link>
    <link name="leaf_e_4"><pose>0.225 0 0.29 0 0 0</pose><inertial><mass>0.0020</mass><inertia><ixx>0.0000003</ixx><iyy>0.0000009</iyy><izz>0.0000011</izz></inertia></inertial><visual name="visual"><geometry><mesh><uri>model://simple_potted_plant/meshes/leaf_segment.obj</uri><scale>1 0.65 1</scale></mesh></geometry><material><ambient>0.04 0.34 0.06 1</ambient><diffuse>0.07 0.68 0.11 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.062 0.028 0.004</size></box></geometry></collision></link>
    <joint name="leaf_e_j1" type="revolute"><pose>0.012 0 0.29 0 0 0</pose><parent>stem_2</parent><child>leaf_e_1</child><axis><xyz>0 1 0</xyz><limit><lower>-0.55</lower><upper>0.55</upper><effort>0.5</effort><velocity>3</velocity></limit><dynamics><damping>0.032</damping><spring_reference>0</spring_reference><spring_stiffness>0.42</spring_stiffness></dynamics></axis></joint>
    <joint name="leaf_e_j2" type="revolute"><pose>0.075 0 0.29 0 0 0</pose><parent>leaf_e_1</parent><child>leaf_e_2</child><axis><xyz>0 1 0</xyz><limit><lower>-0.70</lower><upper>0.70</upper><effort>0.4</effort><velocity>4</velocity></limit><dynamics><damping>0.025</damping><spring_reference>0</spring_reference><spring_stiffness>0.28</spring_stiffness></dynamics></axis></joint>
    <joint name="leaf_e_j3" type="revolute"><pose>0.135 0 0.29 0 0 0</pose><parent>leaf_e_2</parent><child>leaf_e_3</child><axis><xyz>0 1 0</xyz><limit><lower>-0.85</lower><upper>0.85</upper><effort>0.3</effort><velocity>4</velocity></limit><dynamics><damping>0.020</damping><spring_reference>0</spring_reference><spring_stiffness>0.20</spring_stiffness></dynamics></axis></joint>
    <joint name="leaf_e_j4" type="revolute"><pose>0.195 0 0.29 0 0 0</pose><parent>leaf_e_3</parent><child>leaf_e_4</child><axis><xyz>0 1 0</xyz><limit><lower>-1.00</lower><upper>1.00</upper><effort>0.2</effort><velocity>5</velocity></limit><dynamics><damping>0.015</damping><spring_reference>0</spring_reference><spring_stiffness>0.12</spring_stiffness></dynamics></axis></joint>

    <!-- Pilot: one leaf cut directly from the downloaded textured Foliage
         mesh. Five links preserve its original curved shape and UV mapping. -->
    <link name="original_leaf_1"><pose>0.010 0.005 0.200 0 0 0</pose><inertial><mass>0.0040</mass><inertia><ixx>0.000006</ixx><iyy>0.000006</iyy><izz>0.000003</izz></inertia></inertial><visual name="visual"><geometry><mesh><uri>model://simple_potted_plant/meshes/original_leaf_pilot/original_leaf_segment_1.obj</uri></mesh></geometry></visual><collision name="collision"><pose>-0.0075 -0.0075 0.0425 0 -1.744  -2.356</pose><geometry><box><size>0.089 0.025 0.006</size></box></geometry></collision></link>
    <link name="original_leaf_2"><pose>-0.005 -0.010 0.285 0 0 0</pose><inertial><mass>0.0035</mass><inertia><ixx>0.000006</ixx><iyy>0.000006</iyy><izz>0.000003</izz></inertia></inertial><visual name="visual"><geometry><mesh><uri>model://simple_potted_plant/meshes/original_leaf_pilot/original_leaf_segment_2.obj</uri></mesh></geometry></visual><collision name="collision"><pose>-0.0115 -0.0200 0.0500 0 -1.159 -2.093</pose><geometry><box><size>0.110 0.040 0.006</size></box></geometry></collision></link>
