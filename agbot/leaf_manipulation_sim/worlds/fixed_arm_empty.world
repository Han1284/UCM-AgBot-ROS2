<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="fixed_arm_empty">
    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.80 0.85 0.90 1</background>
      <shadows>false</shadows>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://calibration_floor</uri>
    </include>

    <!-- Gazebo Classic freezes when a rendering sensor is embedded in the
         static articulated TM model. This headless renderer supplies RGBD;
         the official D435 visual and TF remain attached to the robot URDF. -->
    <model name="rgbd_renderer">
      <static>true</static>
      <pose>0.4 0 0.8 0 0.6 0</pose>
      <link name="camera_link">
        <sensor name="handeye_rgbd_camera" type="depth">
          <always_on>true</always_on>
          <update_rate>5.0</update_rate>
          <visualize>false</visualize>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>320</width>
              <height>240</height>
              <format>B8G8R8</format>
            </image>
            <depth_camera/>
            <clip>
              <near>0.1</near>
              <far>3.0</far>
            </clip>
          </camera>
          <plugin name="handeye_rgbd_camera_plugin" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/camera</namespace>
              <remapping>color/depth/image_raw:=depth/image_raw</remapping>
              <remapping>color/depth/camera_info:=depth/camera_info</remapping>
              <remapping>color/points:=depth/color/points</remapping>
            </ros>
            <camera_name>color</camera_name>
            <frame_name>camera_depth_optical_frame</frame_name>
            <min_depth>0.1</min_depth>
            <max_depth>3.0</max_depth>
          </plugin>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
